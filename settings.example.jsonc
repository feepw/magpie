// An annotated example of magpie's settings file.
//
// The real file is ~/.config/magpie/settings.json (beside a portable
// magpie; see appdir.Portable). It is plain JSON: the // comments here are
// documentation only and are not read. Every field is optional: one that is
// left out keeps the default noted below. Magpie's Settings pages rewrite
// the whole file when they save, so a hand edit survives only while the
// file still parses.
//
// The fields and their descriptions are those of the Settings struct in
// internal/settings/settings.go, and of OTel in internal/settings/otel.go,
// with the file's own default and accepted values added to each.
{
  // ---- Look and language ----

  // What the window and the tray panel are painted with.
  // Values: "system", "light", "dark". Default: "system" (follow the OS).
  "theme": "system",

  // The language magpie speaks in its own interface.
  // Values: "system", "en", "zh". Default: "system" (follow the OS).
  "lang": "system",

  // What clicking the tray icon opens.
  // Values: "panel" (the usage panel), "window" (the main window).
  // Default: "panel".
  "tray": "panel",

  // The Mac app that opens a resumed session, by bundle id. "" and
  // "system" follow the .command file association.
  // Example: "com.googlecode.iterm2". Default: "".
  "sessionTerminal": "com.googlecode.iterm2",

  // What a cost - the Usage page's, the tray panel's, the TUI's and the
  // CLI's - is shown converted to: "usd" (its native currency, list prices
  // being in dollars) or "cny", at a live exchange rate (see internal/fx).
  // A vendor's own balance, already in its own currency, is never touched
  // by this. Values: "usd", "cny". Default: "usd".
  "currency": "usd",

  // Shortens a large count in Chinese units when magpie speaks Chinese
  // (8000 wan rather than 80M); otherwise it is in K, M and B, as prices
  // per million tokens and context windows (200K, 1M) are, in Chinese too
  // (#740). It means nothing in English. It replaces westernUnits, which
  // asked for K/M/B: what that chose is now the default, so an old file's
  // is left unread. Default: false.
  "chineseUnits": false,

  // Keeps magpie in the Mac's Dock as well as the menu bar, for a menu bar
  // too full to show its icon. Default: false. This computer's own: never
  // synced.
  "dock": false,

  // Shows magpie in the Dock only while its window is open, so Cmd-Tab
  // reaches the window without an icon kept there the rest of the time.
  // Dock wins over it. Default: false. This computer's own: never synced.
  "dockWindow": false,

  // How large the window's and the tray panel's pages are drawn, in
  // percent: the webviews' own zoom, as a browser's, so the text and
  // everything around it grow together.
  // Values: 100, 110, 125, 150. Default: 100.
  "textSize": 100,


  // ---- Network ----

  // The proxy magpie's own requests to vendors go through: "" follows the
  // environment and then the system, "direct" uses none, anything else is
  // the proxy (http://, https:// or socks5://; host:port means http).
  // Example: "http://127.0.0.1:7890". Default: "". This computer's own:
  // never synced.
  "proxy": "http://127.0.0.1:7890",

  // A GitHub download mirror an update's file is fetched through, its
  // prefix put before the release's github.com URL
  // (https://mirror.example/https://github.com/...): "" for none, which is
  // the default - magpie names no mirror of its own. The file is still
  // checked against the SHA-256 the update feed at usemagpie.ai gives,
  // never one from the mirror. `magpie update mirror` sets it. Default: "".
  "updateMirror": "",

  // Shares the gateway on the local network; remote callers must use named
  // caller keys. Default: false.
  "lan": false,

  // Retained for older Magpie versions. Default: "".
  "lanKey": "",

  // Remembers the default named key created when sharing is enabled.
  // Default: "".
  "lanKeyId": "",


  // ---- OTLP export ----
  //
  // The optional OTLP/HTTP metadata export: "endpoint" is the base URL,
  // including /api/public/otel for Langfuse; signals append /v1/traces or
  // metrics. The MAGPIE_OTEL_* environment variables override these fields
  // without changing the file.
  "otel": {
    // Whether to export at all. Default: false.
    "enabled": false,

    // The base URL signals are appended to; required when enabled.
    // Example: "https://cloud.langfuse.com/api/public/otel". Default: "".
    "endpoint": "https://cloud.langfuse.com/api/public/otel",

    // Headers every exported request carries, for authentication. Langfuse
    // wants a Basic Authorization header and takes the version header.
    // Default: {}.
    "headers": {
      "Authorization": "Basic cHVibGljOnNlY3JldA==",
      "x-langfuse-ingestion-version": "4"
    },

    // Exports metrics as well as traces. Default: false.
    "metrics": false,

    // Follows newly recorded local Codex and Pi interactions.
    // Default: false.
    "sessions": false,

    // Adds each call's request and reply, as the gateway captured them
    // (secrets masked, cut at 256 KiB), to its span as Langfuse's
    // observation input and output (#538); off, only metadata leaves.
    // Default: false.
    "bodies": false,

    // Keeps those bodies entire, not cut at 256 KiB: the reply is written
    // to a temporary file as it streams and read back for the export, so a
    // long prompt or reply reaches the trace whole. Only meaningful with
    // "bodies" on. Default: false.
    "bodiesWhole": false
  },


  // ---- Secrets in what agents send ----

  // A GitHub token the library's requests to GitHub's API carry, raising
  // its rate limit from 60 requests an hour to 5,000. It is a secret: the
  // Settings page is told only a masked one, and a backup or sync without
  // keys leaves it out, as it does "lanKey".
  // Example: "github_pat_11ABCDEFG...". Default: "".
  "githubToken": "",

  // Keeps secrets in what agents send (API keys, private keys, tokens,
  // passwords) from the vendors behind magpie: they go as placeholders,
  // and come back as they were. Default: false.
  "redact": false,

  // Does the same for emails, phone numbers and ID and bank card numbers
  // (with "redact" on). Default: false.
  "redactPersonal": false,

  // Masks the user's own words too, with "redact" on.
  // Example: ["Acme Corp"]. Default: [].
  "redactWords": [],

  // The user's own rules for secrets magpie's don't know (a gateway's
  // "oc_sk_..." key), a "prefix" or a "regex" each, masked with the
  // secrets while "redact" is on. "kind" names the placeholder, "" becoming
  // CUSTOM. A prefix is 3-64 characters, a regex at most 300, at most 32
  // rules. Default: [].
  "redactRules": [
    { "kind": "GATEWAY", "prefix": "gw_sk_" },
    { "kind": "INTERNAL", "regex": "acme-[0-9a-f]{32}" }
  ],


  // ---- Request archive ----

  // Keeps each call the gateway serves - its headers and bodies both ways,
  // secrets taken out - in the S3 bucket sync keeps its backup in
  // (gateway/archive.go), for looking into a request later. Default: false.
  "requestArchive": false,

  // How much of each body the archive keeps, in MiB: 0 for 32, at most
  // 1024 (#447). Default: 0.
  "requestArchiveMaxMB": 0,


  // ---- Account warm-ups and daily check-ins ----

  // Starts a ChatGPT account's next window as soon as the last one resets,
  // with one tiny request, so it counts from then (a Codex window starts at
  // its first use).
  // Values: "" (off), "week" (the weekly window), "all" (the 5-hour one
  // too). Default: "".
  "codexWarmup": "",

  // CodexWarmup for the Claude accounts, the request sent through Claude
  // Code. Values: "" (off), "week", "all". Default: "".
  "claudeWarmup": "",

  // Starts each ChatGPT account's 5-hour window at a time of day of the
  // user's choosing, local "15:04", with the same tiny request: an account
  // whose 5-hour window isn't running then gets one, so the windows line up
  // with the day (06:00 gives three by 21:00, where the first use at 9
  // gives two by the end of it); "" off. It works with "codexWarmup" or
  // without it. Example: "06:00". Default: "".
  "codexWarmAt": "",

  // CodexWarmAt for the Claude accounts. Example: "09:30". Default: "".
  "claudeWarmAt": "",

  // The ChatGPT accounts (lower-case) that spend one of their rate-limit
  // resets by themselves once their weekly window is used up and no other
  // account can take the request: at most one a week each (see
  // provider.AutoUseCodexReset); and one about to run out unused half an
  // hour before it does, or at once when the account is held up past then
  // (provider.SpendExpiringCodexResets). Default: [].
  "codexAutoReset": [],

  // Presses WorkBuddy's daily check-in for each signed-in WorkBuddy
  // (China) account once a Beijing day, claiming the credits it gives
  // while its event runs. Default: false.
  "workbuddyCheckin": false,

  // Presses Trae CN's daily check-in for each signed-in Trae CN account
  // (its plugin's) once a Beijing day, claiming the credits it gives.
  // Default: false.
  "traeCheckin": false,


  // ---- Models magpie picks for you ----

  // The model that describes an image to a model that can't see it: a
  // model's id (provider/model, group/<id>), "off" to turn such an image
  // away, or empty for one magpie picks (see gateway.seer).
  // Example: "my-relay/gpt-5-mini". Default: "".
  "vision": "",

  // The model magpie's generate_image tool draws with (the gateway's
  // /v1/images/generations when a request names no model): a model's id,
  // "off", or empty for one magpie picks (gateway.drawer). "off" turns the
  // video a request that names no model gets off too (gateway.videomaker).
  // Example: "my-relay/gpt-image-2". Default: "".
  "imageGen": "",

  // The provider that searches the web for a model that can't:
  // "<provider>" with the small model magpie picks of it,
  // "<provider>/<model>", or empty for the one magpie picks
  // (gateway.searcher). One that is gone, off or can't search gives way to
  // magpie's pick. Example: "my-relay/gpt-5-mini". Default: "".
  "searcher": "",


  // ---- Menu bar / tray usage ----

  // The subscriptions and plans whose windows are shown beside the tray
  // icon, in the order shown, each by its provider and account
  // ("claude|a@b.c"); none when empty. Default: [].
  // This computer's own: never synced.
  "trayUsages": [],

  // TrayUsages' first, all a magpie before them read: a file with it and no
  // "trayUsages" shows that one, and it is kept written for an older magpie
  // to go on showing it. Default: "". This computer's own: never synced.
  "trayUsage": "",

  // How often, in minutes, that text is brought up to date; 0 is every 3.
  // Values: 1, 3, 5, 10, 30. Default: 3. This computer's own: never synced.
  "trayUsageEvery": 3,

  // Draws the Mac menu bar's cards without their logos: each is its windows
  // stacked alone, a thin line between one card and the next. Default:
  // false. This computer's own: never synced.
  "trayNoLogos": false,

  // Lets the webview of a window closed - the tray panel or the main window
  // - go once it has stayed closed a while, and makes it again when it is
  // opened (#580): less memory, a moment's wait. This computer's own
  // (KeepOwn). Default: false.
  "lightweight": false,

  // Shows a subscription's windows by how much of each is left, not used:
  // the Usage page, the tray panel and the menu bar alike. Default: false.
  "quotaLeft": false,

  // How much of a subscription's or plan's window, in percent, is used when
  // magpie says so with a notification (#368): once for each time the
  // window runs, for every window routing counts (not one set aside, as
  // on-demand spending is); 0 is off. Values: 1-100, or 0 for off.
  // Default: 0.
  "usageAlert": 0,

  // The balance a key or account has fallen to when magpie says so, in that
  // balance's own currency or credits, once until it is topped up past it
  // again; 0 is off. Example: 5. Default: 0.
  "balanceAlert": 0,


  // ---- Model list naming ----

  // Has the model lists magpie gives agents name each model by its name
  // alone, without its provider's or "routing group" after it (#335) - but
  // for two in one list that would read the same, which keep it (see
  // provider.Labels). Default: false.
  "plainNames": false,

  // With "plainNames" off, has those lists name a model the user gave a
  // name of their own by that name alone, just as they wrote it (#92:
  // "Opus 5.5", not "Opus 5.5 - Claude Code"), the vendor's names keeping
  // their provider's after them (see provider.Labels). Default: false.
  "plainOwnNames": false,


  // ---- Codex ----

  // Has the OpenAI models magpie hands Codex - the ChatGPT account's own,
  // their codex/ ids and the groups one is in - say multi_agent_version
  // "v1" (#141): their subagents are then handed their tasks as text,
  // which a magpie-served subagent can read, where V2's are sealed by
  // OpenAI's server. Codex's features.multi_agent_v2 still wins, and a
  // thread keeps the version it started with. Default: false.
  "codexAgentsV1": false,

  // Where the requests Codex makes for a thread's title (thread_title,
  // thread_title_reconsideration: a hidden turn of their own, on Codex's
  // own model through its ChatGPT sign-in) go (#705): "" as Codex sends
  // them, "off" answered by magpie with no title and sent nowhere, or a
  // model's id (provider/model, group/<id>) that writes it.
  // Example: "my-relay/gpt-5-mini". Default: "".
  "codexTitles": "",


  // ---- Updates, mirrors and telemetry ----

  // The Plugins page's China Mirror switch: the plugin list, npm (the
  // plugins' packages and what npm says of them) and Bun's downloads are
  // asked of mirrors in China first, and of their official addresses after
  // (see source.China). Default: false.
  "chinaMirror": false,

  // Stops the one event a day that counts magpie's users (see
  // internal/stats). Default: false.
  "noStats": false,

  // Keeps the header's Update pill away when a newer magpie is out.
  // Default: false.
  "noUpdatePill": false,

  // The one version the Update pill was hidden for, and a newer one brings
  // it back. Either way magpie still downloads the version and puts it in
  // as it quits, and Settings' version row still offers it.
  // Example: "0.45.0". Default: "".
  "updateSkip": "",

  // Stops magpie asking for a newer version by itself, and so downloading
  // one (#472): only Settings' Check, or `magpie update`, asks then.
  // Default: false.
  "noAutoUpdate": false,

  // How often magpie asks for a newer version otherwise, in minutes; one of
  // the accepted values, 0 for every six hours.
  // Values: 30, 60, 360, 1440. Default: 360.
  "updateEvery": 360,


  // ---- Agents ----
  //
  // How the agents are listed, by agent id. The agents' own files never
  // hear of any of this.

  // Comes first, as ordered; an agent it doesn't name (one installed since)
  // follows in magpie's own order. Default: [].
  "agentOrder": [],

  // A hidden agent is folded away at the bottom of the list. Default: [].
  "agentsHidden": [],

  // A shown one stays in view even while nothing is set on it, which
  // otherwise folds it away too. Default: [].
  "agentsShown": [],


  // ---- Providers and models, per agent ----

  // How the Usage page's cards are listed, by provider id, as they were
  // dragged there; one it doesn't name follows in magpie's own order. Only
  // the page's: the order providers are tried in is the Providers page's.
  // Default: [].
  "usageOrder": [],

  // Narrows the models an agent is shown, by agent id: the families (the
  // tag a provider or group is given), provider ids and group ids its lists
  // hold. An agent it doesn't name is shown them all. Default: {}.
  "visible": {},

  // The catalog entries (their ids, "<provider>/<model>" or a group's)
  // taken out of an agent's lists one by one, by agent id, after "visible":
  // a model not named here, a new one among them, is shown. Default: {}.
  "hiddenModels": {},


  // ---- Per-model overrides ----
  //
  // Every map below is keyed "<provider id>/<model id>", or
  // "<provider id>/*" for all of that provider's models. "modelPrices"
  // alone also takes "*/<model id>", pricing that model at whatever
  // provider it comes through (including one that is gone).

  // The names the user gave models, by "<provider id>/<model id>": agents,
  // the gateway's model list and magpie itself show them for the vendor's
  // (see provider.SetModelName). Default: {}.
  "modelNames": {
    "my-relay/gpt-5": "GPT-5 (relay)",
    "anthropic/claude-opus-4-6": "Opus 4.6"
  },

  // The reasoning levels the user keeps of a model's, by "<provider
  // id>/<model id>": the lists magpie hands out offer only those (see
  // provider.SetModelEfforts). Default: {}.
  "modelEfforts": {
    "my-relay/gpt-5": ["low", "medium", "high"]
  },

  // Whether the user said a model takes images, by "<provider
  // id>/<model id>". Absent leaves it to the vendor's list. Default: {}.
  "modelImages": {
    "my-relay/gpt-5": true
  },

  // What a model costs the user, in USD per million tokens, by "<provider
  // id>/<model id>", and "*" for every model of that provider: a provider
  // models.dev does not list, or one that resells at a multiplier, is
  // otherwise priced at whatever its maker's list price is. "*/<model id>"
  // (an "any provider" key) is that model from any provider not priced
  // above, and a session's model named with no provider at all. A price
  // must give every part (input, output, cache_read, cache_write) or it is
  // not used. Default: {}.
  "modelPrices": {
    "my-relay/gpt-5": { "input": 1.25, "output": 10, "cache_read": 0.125, "cache_write": 1.5 },
    "my-relay/*": { "input": 0.5, "output": 1.5, "cache_read": 0.05, "cache_write": 0.5 },
    "*/claude-opus-4-6": { "input": 15, "output": 75, "cache_read": 1.5, "cache_write": 18.75 }
  },

  // The most a reply of a model may hold, by "<provider id>/<model id>",
  // and "*" for every model of that provider. Absent leaves it to the
  // vendor's own list and to models.dev. A model's own value wins over its
  // provider's. Default: {}.
  "modelOutputs": {
    "my-relay/gpt-5": 128000,
    "my-relay/*": 64000
  },

  // The name to send a vendor for a model magpie knows by another, by
  // "<provider id>/<model id>", and "*" for every model of that provider.
  // A "*" in the name is the model itself, so one name covers a relay that
  // namespaces its models - vendor-ns/* asks for model-3 as
  // vendor-ns/model-3 - while a name with no "*" in it sends every model of
  // that key under that one name. Everything else - the catalog agents see,
  // the routing groups, the usage records and what a call is priced at -
  // keeps the name magpie knows the model by. Default: {}.
  "modelWires": {
    "my-relay/claude-opus-4-6": "claude-4-6-opus-latest",
    "my-relay/*": "relay-ns/*"
  },

  // The one API a model is asked on at its provider, by "<provider
  // id>/<model id>": "chat", "responses" or "anthropic", for a relay whose
  // one key serves some models on one and others on another. Absent leaves
  // it to the vendor's list and to each URL the provider has (see
  // provider.SetModelAPI). Default: {}.
  "modelAPIs": {
    "my-relay/gpt-5": "responses",
    "my-relay/claude-opus-4-6": "anthropic"
  },

  // The model another vendor sells under another name that a model is, by
  // "<provider id>/<model id>": the routing groups magpie finds (provider's
  // autoGroups) merge it with that one rather than by its own id, for an id
  // no rule of magpie's matches up. Absent leaves it to its id. Default: {}.
  "modelSameAs": {
    "my-relay/claude-4-6-opus": "anthropic/claude-opus-4-6"
  },


  // The main window's size when it was last resized, width and height, so
  // it opens at it again after a restart. Default: []. This computer's own:
  // never synced.
  "window": []
}
